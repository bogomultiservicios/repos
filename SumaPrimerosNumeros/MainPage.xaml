<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SumaPrimerosNumeros.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Ingresar Número" 
                   x:Name="cajaNumero"/>
            <Button Text="Calcular" 
                    Clicked="CalcularSecuencia"/>
            <Label Text="Total: " 
                   x:Name="cajaTotal"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
