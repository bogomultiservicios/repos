<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="cuentaAhorro.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Ingresar Monto Ahorro" 
                   x:Name="cajaAhorro"/>
            <Entry Placeholder="Ingresar Meses Ahorro" 
                   x:Name="cajaMeses"/>
            <Button Text="Generar Estado de Cuenta" 
                    Clicked="generarEstadoAhorro"/>
            <StackLayout x:Name="cajaEstado">
                
            </StackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
