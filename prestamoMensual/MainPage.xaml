<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="prestamoMensual.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Monto a prestar" 
                   x:Name="cajaMonto"/>
            <Entry Placeholder="Meses del prestamo" 
                   x:Name="cajaMeses"/>
            <Button Text="Generar Prestamo" 
                    Clicked="iniciarPrestamos"/>
            <StackLayout x:Name="cajaEstado">
                
            </StackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
