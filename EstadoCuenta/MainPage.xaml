<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstadoCuenta.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Ingresar monto a Prestar" 
                   x:Name="cajaMonto"/>
            <Entry Placeholder="Ingresar Meses a Pagar" 
                   x:Name="cajaMeses"/>
            <Button Text="Generar Estado de Cuenta" 
                    Clicked="generarEstado"/>
            <StackLayout x:Name="cajaEstado">
                
            </StackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
