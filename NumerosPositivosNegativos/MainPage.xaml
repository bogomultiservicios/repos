<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NumerosPositivosNegativos.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Ingrese un número"
                   x:Name="campoNumero"
                   Keyboard="Numeric"/>
            <Button Text="Calcular"
                    Clicked="detectarNumeroPositivoNegativo"/>
            <Label Text="Resultado:"
                   x:Name="textoResultado"
                   FontSize="18"/>
            <Button Text="Calcular If Else"
        Clicked="detectarNumeroIfElse"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
